<Window x:Class="UsetimeManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UsetimeManager.Controls"
        Title="屏幕使用时长统计"
        Width="880" Height="860"
        MinWidth="720" MinHeight="640"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" Margin="20,24,20,32">
            <!-- 标题 -->
            <DockPanel Margin="0,0,0,16">
                <TextBlock DockPanel.Dock="Left"
                           Text="屏幕使用时长统计"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}"/>
                <Button DockPanel.Dock="Right"
                        x:Name="RefreshButton"
                        Content="刷新"
                        Padding="14,8"
                        Background="{StaticResource CardBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource Ink2Brush}"
                        Cursor="Hand"
                        Click="RefreshButton_Click"/>
            </DockPanel>

            <!-- 日/周/月 -->
            <Border Background="#E7E9EF" CornerRadius="18" Padding="6" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TabDay" Grid.Column="0" Content="日"
                            Height="48" Margin="0,0,3,0"
                            FontWeight="SemiBold" FontSize="17"
                            Background="{StaticResource CardBrush}"
                            BorderThickness="0" Foreground="{StaticResource InkBrush}"
                            Click="TabDay_Click"/>
                    <Button x:Name="TabWeek" Grid.Column="1" Content="周"
                            Height="48" Margin="3,0,3,0"
                            FontWeight="SemiBold" FontSize="17"
                            Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource Ink2Brush}"
                            Click="TabWeek_Click"/>
                    <Button x:Name="TabMonth" Grid.Column="2" Content="月"
                            Height="48" Margin="3,0,0,0"
                            FontWeight="SemiBold" FontSize="17"
                            Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource Ink2Brush}"
                            Click="TabMonth_Click"/>
                </Grid>
            </Border>

            <!-- 汇总卡片 -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="999"
                            HorizontalAlignment="Left" Padding="6,0" Height="44">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="‹" Width="32" Height="32"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="18" Click="Prev_Click"/>
                            <TextBlock x:Name="DateLabel" Text="今日"
                                       FontSize="16" FontWeight="SemiBold"
                                       MinWidth="160" TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource InkBrush}"/>
                            <Button Content="›" Width="32" Height="32"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="18" Click="Next_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SummaryTitle" Text="今日屏幕使用时长"
                               Foreground="{StaticResource Ink2Brush}"
                               FontSize="15" Margin="0,16,0,0"/>
                    <TextBlock x:Name="SummaryTotal" Text="0分钟"
                               FontSize="40" FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,6,0,0"/>
                    <TextBlock x:Name="SummaryDelta" Text="暂无数据"
                               Foreground="{StaticResource Ink2Brush}"
                               FontSize="15" Margin="0,6,0,16"/>

                    <TextBlock x:Name="ChartPlaceholder"
                               Text="采集开始后，这里会显示分时柱状图"
                               Height="280"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource Ink3Brush}"
                               FontSize="14"/>
                    <Canvas x:Name="ChartHost" Height="280" HorizontalAlignment="Stretch">
                        <local:BarChart x:Name="Chart" Height="280"
                                        Width="700"
                                        HorizontalAlignment="Left"
                                        Visibility="Collapsed"/>
                    </Canvas>
                </StackPanel>
            </Border>

            <!-- 应用排行卡片 -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="20" Padding="22">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   x:Name="AppListTitle"
                                   Text="今日应用使用情况"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <Button DockPanel.Dock="Right"
                                x:Name="SortButton"
                                Content="时长 ⇅"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource Ink2Brush}"
                                Click="SortButton_Click"/>
                    </DockPanel>
                    <TextBlock x:Name="AppListEmpty"
                               Text="暂无应用使用数据"
                               Foreground="{StaticResource Ink3Brush}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,12"/>
                    <StackPanel x:Name="AppListHost"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
